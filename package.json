{
  "name": "pethub-nigeria",
  "version": "1.0.0",
  "description": "Comprehensive pet platform for Nigeria - Social networking, e-commerce, and marketplace",
  "private": true,
  "workspaces": [
    "backend",
    "frontend",
    "shared"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm run dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "build": "npm run build --workspaces",
    "build:backend": "npm run build --workspace=backend",
    "build:frontend": "npm run build --workspace=frontend",
    "test": "npm run test --workspaces",
    "lint": "npm run lint --workspaces",
    "clean": "rm -rf node_modules backend/node_modules frontend/node_modules shared/node_modules backend/dist frontend/dist"
  },
  "keywords": [
    "pets",
    "e-commerce",
    "marketplace",
    "social-network",
    "nigeria"
  ],
  "author": "PetHub Nigeria Team",
  "license": "PROPRIETARY",
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
